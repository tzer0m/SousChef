<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#2e7d4f" />
    <title>@ViewData["Title"] - SousChef</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="icon" href="~/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SousChef.styles.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <header>
        <nav class="navbar navbar-expand navbar-dark sc-navbar mb-3">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-page="/Index">🍳 SousChef</a>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">Library</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Import">Import</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>